# ur's winget installer manifest (sidecar DESIGN.md §4.10, §4.18), rendered by
# build/all/ur-channels.zsh from a promoted release's signed SHA256SUMS: the signed zip, portable, with
# git-remote-ur under its own alias so that git finds it on PATH.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.6.0.schema.json

PackageIdentifier: URnetwork.ur
PackageVersion: @VERSION@
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
  - RelativeFilePath: ur.exe
    PortableCommandAlias: ur
  - RelativeFilePath: git-remote-ur.exe
    PortableCommandAlias: git-remote-ur
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/urnetwork/build/releases/download/v@VERSION@/ur-@VERSION@-windows-amd64.zip
    InstallerSha256: @SHA256_WINDOWS_AMD64@
  - Architecture: arm64
    InstallerUrl: https://github.com/urnetwork/build/releases/download/v@VERSION@/ur-@VERSION@-windows-arm64.zip
    InstallerSha256: @SHA256_WINDOWS_ARM64@
ManifestType: installer
ManifestVersion: 1.6.0

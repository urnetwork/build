# URnetwork Linux DAEMON build container — Ubuntu 22.04.
#
# WHY 22.04 AND NOT 24.04: this image's glibc IS the floor the package
# declares. linux/packaging/deb/nfpm.yaml says `Depends: libc6 (>= 2.35)`, and
# nfpm does not run dpkg-shlibdeps, so nothing but the build image couples that
# hand-written dependency to reality. Measured on arm64 (2026-08-05): a daemon
# built on Ubuntu 24.04 references __isoc23_strtoll/strtoul/strtoull@GLIBC_2.38
# (glibc 2.38's C23 strtol redirect, reached through nlohmann/json's number
# parser) and arc4random@GLIBC_2.36 — so a 24.04 daemon CANNOT honestly claim
# 2.35: it installs on Ubuntu 22.04 / Debian 12 and then fails to exec. The
# app's `glibc-floor` meson test catches exactly this and fails the build.
#
# 22.04 has no libgtkmm-4.0 at all, which is why linux/app's `gui` option is a
# feature: -Dgui=disabled builds the daemon half only. The GUI/AppImage half
# builds separately on 24.04 — see Dockerfile.gui.
#
# See build.sh (host orchestration), build-arch.sh (runs inside, ROLE=daemon),
# verify.sh, and ../run.sh (Linux section).
# SPDX-License-Identifier: MPL-2.0
FROM ubuntu:22.04

ENV LANG=C.UTF-8

# - g++/meson/ninja/pkg-config + glib/json/gettext: the daemon half's build deps
#   (NO GTK: the daemon links gio/glib + json + threads + the SDK, nothing else)
# - binutils: readelf, which the glibc-floor gate uses
# - dpkg-dev/fakeroot/tar: .deb + install-tarball packaging and its verification
# - systemd: `systemd-analyze verify` (a static unit check; never booted here)
# - iproute2/nftables/libfuse2: satisfy the .deb's runtime dependencies so
#   `dpkg -i` can CONFIGURE during verification (22.04 predates the libfuse2t64
#   rename). If one is missing, dpkg only unpacks the package and never runs
#   postinst, so the urnetwork group and /etc integration files never appear
#   and the lifecycle test fails misleadingly.
# - rpm/checkpolicy/semodule-utils: the .rpm. make-rpm.sh is nfpm-based (below)
#   and needs no rpmbuild, but it HARD-DIES without checkmodule AND
#   semodule_package: the Fedora-family package ships a compiled SELinux policy
#   module, and without it systemd runs urnetworkd in init_t, which is denied
#   /dev/net/tun — so every Connect fails on an Enforcing host. The package
#   split differs by family and guessing wrong looks identical to not trying:
#   semodule_package is in *semodule-utils* on Debian/Ubuntu (policycoreutils
#   here ships semodule/sestatus/setfiles and NOT the packager), but in
#   policycoreutils on Fedora. `rpm` itself is not a nice-to-have either —
#   without it make-rpm.sh SKIPS its whole payload assertion and degrades to a
#   single warning, and that assertion is what catches an rpm containing no
#   daemon.
#
#   22.04 is the RIGHT host for this for a second, independent reason:
#   semodule_package stamps the module with the BUILD host's libsepol policy
#   version and a target whose libsepol is OLDER refuses it. Building on
#   jammy's libsepol 3.3 for Fedora's 3.6+ is the safe direction; building on a
#   bleeding-edge host for RHEL is not.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends \
        g++ \
        meson \
        ninja-build \
        pkg-config \
        libglib2.0-dev \
        libglib2.0-bin \
        nlohmann-json3-dev \
        gettext \
        binutils \
        unzip \
        dpkg-dev \
        fakeroot \
        rpm \
        checkpolicy \
        semodule-utils \
        file \
        desktop-file-utils \
        systemd \
        iproute2 \
        nftables \
        libfuse2 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# nfpm — make-deb.sh builds the .deb with it. Pinned and checksum-verified
# against the release's checksums.txt; goreleaser's apt repo would need
# [trusted=yes], which is strictly worse. v2.47 is what linux/packaging
# verified against.
ARG NFPM_VERSION=2.47.0
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) nfpm_deb="nfpm_${NFPM_VERSION}_amd64.deb" ;; \
      arm64) nfpm_deb="nfpm_${NFPM_VERSION}_arm64.deb" ;; \
      *) echo "ERROR: unsupported arch $(dpkg --print-architecture) for nfpm"; exit 1 ;; \
    esac; \
    base="https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}"; \
    curl -fsSL -o "/tmp/${nfpm_deb}" "${base}/${nfpm_deb}"; \
    curl -fsSL -o /tmp/nfpm-checksums.txt "${base}/checksums.txt"; \
    (cd /tmp && grep " ${nfpm_deb}\$" nfpm-checksums.txt | sha256sum -c -); \
    dpkg -i "/tmp/${nfpm_deb}"; \
    rm -f "/tmp/${nfpm_deb}" /tmp/nfpm-checksums.txt; \
    nfpm --version

# Fail at `docker build` if a base-image change ever drops the SELinux
# packager, rather than 40 minutes into an emulated build inside make-rpm.sh's
# die. Mirrors the same pre-flight in linux/.github/workflows/beta-build.yml —
# the split between checkpolicy and semodule-utils is exactly the kind of thing
# a distro rearranges between LTSes.
RUN set -eu; \
    for t in checkmodule semodule_package; do \
      command -v "$t" >/dev/null 2>&1 || { \
        echo "ERROR: $t is missing after installing checkpolicy + semodule-utils"; \
        echo "       — make-rpm.sh cannot build the SELinux policy module without it."; \
        exit 1; \
      }; \
    done; \
    rpm --version

# *important* gettext (msgfmt) is required, not optional: meson's i18n module
# SILENTLY disables translations when msgfmt is missing — the build still
# succeeds and the daemon ships english-only catalogs, with no error to notice.
# build-arch.sh carries a matching tripwire on the staged *.mo files.
